# Copy to terraform.tfvars and edit.

proxmox_endpoint  = "https://192.168.1.10:8006/"
proxmox_api_token = "terraform@pve!provider=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_insecure  = true
proxmox_node      = "pve"

# ---------------------------------------------------------------------------
# How the VMs are configured
#   false (default) = no SSH to the Proxmox node needed. Terraform connects
#                     over SSH to the new VM(s) and installs GitLab/Runner.
#   true            = cloud-init snippets; needs root SSH to the Proxmox node
#                     and a datastore with 'snippets' content.
# ---------------------------------------------------------------------------
use_snippets = false

# Private key matching ssh_public_keys below (no passphrase). Used to SSH into
# the VMs when use_snippets = false. On Windows: "C:/Users/<you>/.ssh/id_ed25519"
vm_ssh_private_key_path = "~/.ssh/id_ed25519"

# Only needed when use_snippets = true:
# proxmox_ssh_username         = "root"
# proxmox_ssh_private_key_path = "~/.ssh/id_ed25519"
# snippets_datastore           = "local"

# VM disks on the NetApp iSCSI storage (LVM over iSCSI).
vm_datastore = "iscsi-netapp"

# Ubuntu cloud image. With use_snippets = false it must be of 'import' content
# type. Either let Terraform download it to image_datastore (needs 'Import'
# content enabled there) ...
image_datastore = "local"
# ... or upload it yourself (storage > Import > Upload, name ending in .qcow2)
# and point to it:
# ubuntu_image_file_id = "iso:import/noble-server-cloudimg-amd64.qcow2"

network_bridge = "vmbr0"
gateway        = "192.168.1.1"
dns_servers    = ["1.1.1.1", "8.8.8.8"]

vm_user = "ubuntu"
ssh_public_keys = [
  "ssh-ed25519 AAAA... you@laptop",
]

# "single"   = GitLab + Runner on one VM (default)
# "separate" = GitLab VM + dedicated Runner VM (also set runner_vm below)
deployment_mode = "single"

gitlab_vm = {
  vm_id     = 200
  name      = "gitlab"
  ip        = "192.168.1.50/24"
  cores     = 6
  memory_mb = 12288
  disk_gb   = 80
}

# Only used when deployment_mode = "separate".
# runner_vm = {
#   vm_id     = 201
#   name      = "gitlab-runner"
#   ip        = "192.168.1.51/24"
#   cores     = 2
#   memory_mb = 4096
#   disk_gb   = 40
# }

runner_tags              = ["docker", "proxmox"]
runner_concurrent        = 2
runner_docker_privileged = false
